<?xml version="1.0" encoding="utf-8"?>
<Mod id="core" version="1"
	xmlns="ModInfo">
	<Properties>
		<Name>Core</Name>
		<Description>This is a core module of the game.</Description>
		<Authors>LOC_AUTHORS_FIRAXIS</Authors>
		<ShowInBrowser>0</ShowInBrowser>
		<Package>BaseGame</Package>
		<PackageSortIndex>0</PackageSortIndex>
	</Properties>
	<References></References>
	<ActionCriteria>
		<Criteria id="always">
			<AlwaysMet></AlwaysMet>
		</Criteria>
	</ActionCriteria>
	<ActionGroups>
		<ActionGroup id="config-schema" scope="shell" criteria="always">
			<Properties>
				<LoadOrder>-1</LoadOrder> <!-- Ensure this schema update happens FIRST. -->
			</Properties>
			<Actions>
				<UpdateDatabase>
					<Item>config/config-schema.sql</Item>
				</UpdateDatabase>
			</Actions>
		</ActionGroup>
		<ActionGroup id="core-shell" scope="shell" criteria="always">
			<Actions>
				<UpdateDatabase>
					<Item>config/Input.xml</Item>
					<Item>config/SetupParameters.xml</Item>
					<Item>config/TwoKTelemetryEvents.xml</Item>
				</UpdateDatabase>

				<UpdateIcons>
					<Item>icons/icons.xml</Item>
				</UpdateIcons>

				<UpdateText>
					<Item>text/en_us/CoreText.xml</Item>
					<Item>text/en_us/ControllerText.xml</Item>
					<Item>text/en_us/CreateGameText.xml</Item>
					<Item>text/en_us/GrammarText.xml</Item>
					<Item>text/en_us/InputText.xml</Item>
					<Item>text/en_us/LanguageText.xml</Item>
					<Item>text/en_us/OptionsText.xml</Item>
					<Item>text/en_us/ProfileText.xml</Item>
					<Item>text/en_us/SaveLoadText.xml</Item>
					<Item>text/en_us/UIText.xml</Item>
					<Item>text/en_us/UIShellText.xml</Item>
					<Item>text/en_us/MPSharedText.xml</Item>

					<!-- Items below were generated via our loc tool. -->
					<Item locale="de_DE">l10n/de_DE_Text.xml</Item>
					<Item locale="es_ES">l10n/es_ES_Text.xml</Item>
					<Item locale="fr_FR">l10n/fr_FR_Text.xml</Item>
					<Item locale="it_IT">l10n/it_IT_Text.xml</Item>
					<Item locale="ja_JP">l10n/ja_JP_Text.xml</Item>
					<Item locale="ko_KR">l10n/ko_KR_Text.xml</Item>
					<Item locale="pl_PL">l10n/pl_PL_Text.xml</Item>
					<Item locale="pt_BR">l10n/pt_BR_Text.xml</Item>
					<Item locale="ru_RU">l10n/ru_RU_Text.xml</Item>
					<Item locale="zh_Hans_CN">l10n/zh_Hans_CN_Text.xml</Item>
					<Item locale="zh_Hant_HK">l10n/zh_Hant_HK_Text.xml</Item>

					<!-- These text-override entries must happen *after* translations. -->
					<Item platform="Switch">text/en_us/OptionsText_RumbleFeature.xml</Item>
					<Item platform="Ounce">text/en_us/OptionsText_RumbleFeature.xml</Item>
					<Item platform="Switch">text/en_us/OptionsText_Console.xml</Item>
					<Item platform="Ounce">text/en_us/OptionsText_Console.xml</Item>
					<Item platform="PS4">text/en_us/OptionsText_ControllerVibration.xml</Item>
					<Item platform="PS5">text/en_us/OptionsText_ControllerVibration.xml</Item>
					<Item platform="XboxOne">text/en_us/OptionsText_ControllerVibration.xml</Item>
					<Item platform="XboxOne">text/en_us/OptionsText_Console.xml</Item>
					<Item platform="XboxScarlett">text/en_us/OptionsText_ControllerVibration.xml</Item>
					<Item platform="XboxScarlett">text/en_us/OptionsText_Console.xml</Item>
					<Item platform="iOS">text/en_us/OptionsText_AppleArcadeProfileNames.xml</Item>

					<Item platform="PS4">text/en_us/ControllerText_InvertSticks_PS4.xml</Item>
					<Item platform="PS4">text/en_us/InputText_ThumbSticks_PS4.xml</Item>
					<Item platform="PS5">text/en_us/ControllerText_InvertSticks_PS5.xml</Item>
					<Item platform="PS5">text/en_us/InputText_ThumbSticks_PS5.xml</Item>
					<Item platform="XboxOne">text/en_us/ControllerText_InvertSticks_Microsoft.xml</Item>
					<Item platform="XboxOne">text/en_us/InputText_ThumbSticks_Microsoft.xml</Item>
					<Item platform="XboxScarlett">text/en_us/ControllerText_InvertSticks_Microsoft.xml</Item>
					<Item platform="XboxScarlett">text/en_us/InputText_ThumbSticks_Microsoft.xml</Item>

					<Item ecosystem="game-center">text/en_us/InputText_CenterCursor_AppleArcade.xml</Item>
					<Item ecosystem="game-center">text/en_us/MPSharedText_ConnectionLost_AppleArcade.xml</Item>
					<Item ecosystem="game-center">text/en_us/UIShellText_Multiplayer_AppleArcade.xml</Item>
				
				<Item locale="th_TH">l10n/th_TH_Text.xml</Item></UpdateText>

				<UIAudioRules>
					<Item>ui-next/audio-rules.json</Item>
				</UIAudioRules>

				<UIScripts>
					<Item>ui/module-shell.js</Item>
				</UIScripts>

				<UIShortcuts>
					<Item>ui/debug/asian-font.html</Item>
					<Item>ui/debug/html-preview.html</Item>
					<Item>ui/debug/stylized-markup-text.html</Item>
					<Item>ui/reference/icon-browser.html</Item>
					<Item>ui/reference/icon-fonticons.html</Item>
					<Item>ui/reference/movie-browser.html</Item>
					<Item>ui/shell/root-shell.html</Item>
					<Item>ui/shell/mp-host-setup/page-mp-hostsetup.html</Item>
					<Item>ui-next/sandbox/sandbox.html</Item>
					<Item>ui-next/sandbox/scratchpad.html</Item>
					<Item>ui-next/sandbox/components-browser/components-browser.html</Item>
					<Item>ui-next/reference/text-scratchpad/text-scratchpad.html</Item>
					<Item>ui-next/reference/audio/audio.html</Item>
					<Item>ui-next/reference/drag-and-drop/inventory.html</Item>
				</UIShortcuts>

				<ImportFiles>
					<Item>ui/cohtml.js</Item>
					<Item>ui/component-support.js</Item>
					<Item>ui/accessibility/cohtml-speech-api.js</Item>
					<Item>ui/shell/root-shell.html</Item>
					<Item>ui/utilities/utilities-network.js</Item>
					<Item>ui/utilities/utilities-online.js</Item>
				</ImportFiles>
			</Actions>
		</ActionGroup>
		<ActionGroup id="core-game" scope="game" criteria="always">
			<Actions>
				<UpdateDatabase>
					<Item>data/TurnPhases.xml</Item>
					<Item>data/reporting-events.xml</Item>
					<Item>data/gamecore-events.xml</Item>
				</UpdateDatabase>

				<UpdateIcons>
					<Item>icons/icons.xml</Item>
				</UpdateIcons>

				<UpdateText>
					<Item>text/en_us/CoreText.xml</Item>
					<Item>text/en_us/ControllerText.xml</Item>
					<Item>text/en_us/CreateGameText.xml</Item>
					<Item>text/en_us/GrammarText.xml</Item>
					<Item>text/en_us/InputText.xml</Item>
					<Item>text/en_us/LanguageText.xml</Item>
					<Item>text/en_us/OptionsText.xml</Item>
					
					<Item>text/en_us/ProfileText.xml</Item>
					<Item>text/en_us/SaveLoadText.xml</Item>
					<Item>text/en_us/UIText.xml</Item>
					<Item>text/en_us/UIShellText.xml</Item>
					<Item>text/en_us/MPSharedText.xml</Item>

					<!-- Items below were generated via our loc tool. -->
					<Item locale="de_DE">l10n/de_DE_Text.xml</Item>
					<Item locale="es_ES">l10n/es_ES_Text.xml</Item>
					<Item locale="fr_FR">l10n/fr_FR_Text.xml</Item>
					<Item locale="it_IT">l10n/it_IT_Text.xml</Item>
					<Item locale="ja_JP">l10n/ja_JP_Text.xml</Item>
					<Item locale="ko_KR">l10n/ko_KR_Text.xml</Item>
					<Item locale="pl_PL">l10n/pl_PL_Text.xml</Item>
					<Item locale="pt_BR">l10n/pt_BR_Text.xml</Item>
					<Item locale="ru_RU">l10n/ru_RU_Text.xml</Item>
					<Item locale="zh_Hans_CN">l10n/zh_Hans_CN_Text.xml</Item>
					<Item locale="zh_Hant_HK">l10n/zh_Hant_HK_Text.xml</Item>

					<!-- These text-override entries must happen *after* translations. -->
					<Item platform="Switch">text/en_us/OptionsText_RumbleFeature.xml</Item>
					<Item platform="Ounce">text/en_us/OptionsText_RumbleFeature.xml</Item>
					<Item platform="Switch">text/en_us/OptionsText_Console.xml</Item>
					<Item platform="Ounce">text/en_us/OptionsText_Console.xml</Item>
					<Item platform="PS4">text/en_us/OptionsText_ControllerVibration.xml</Item>
					<Item platform="PS5">text/en_us/OptionsText_ControllerVibration.xml</Item>
					<Item platform="XboxOne">text/en_us/OptionsText_ControllerVibration.xml</Item>
					<Item platform="XboxOne">text/en_us/OptionsText_Console.xml</Item>
					<Item platform="XboxScarlett">text/en_us/OptionsText_ControllerVibration.xml</Item>
					<Item platform="XboxScarlett">text/en_us/OptionsText_Console.xml</Item>
					<Item platform="iOS">text/en_us/OptionsText_AppleArcadeProfileNames.xml</Item>

					<Item platform="PS4">text/en_us/ControllerText_InvertSticks_PS4.xml</Item>
					<Item platform="PS4">text/en_us/InputText_ThumbSticks_PS4.xml</Item>
					<Item platform="PS5">text/en_us/ControllerText_InvertSticks_PS5.xml</Item>
					<Item platform="PS5">text/en_us/InputText_ThumbSticks_PS5.xml</Item>
					<Item platform="XboxOne">text/en_us/ControllerText_InvertSticks_Microsoft.xml</Item>
					<Item platform="XboxOne">text/en_us/InputText_ThumbSticks_Microsoft.xml</Item>
					<Item platform="XboxScarlett">text/en_us/ControllerText_InvertSticks_Microsoft.xml</Item>
					<Item platform="XboxScarlett">text/en_us/InputText_ThumbSticks_Microsoft.xml</Item>

					<Item ecosystem="game-center">text/en_us/InputText_CenterCursor_AppleArcade.xml</Item>
				
				<Item locale="th_TH">l10n/th_TH_Text.xml</Item></UpdateText>

				<UIShortcuts>
					<Item>ui/debug/asian-font.html</Item>
					<Item>ui/debug/html-preview.html</Item>
					<Item>ui/debug/stylized-markup-text.html</Item>
					<Item>ui/reference/icon-browser.html</Item>
					<Item>ui/reference/icon-fonticons.html</Item>
					<Item>ui/reference/icon-reference.html</Item>
					<Item>ui/reference/movie-browser.html</Item>
					<Item>ui-next/sandbox/sandbox.html</Item>
					<Item>ui-next/sandbox/components-browser/components-browser.html</Item>
					<Item>ui-next/reference/text-scratchpad/text-scratchpad.html</Item>
					<Item>ui-next/reference/drag-and-drop/inventory.html</Item>
				</UIShortcuts>

				<ImportFiles>
					<Item>ui/cohtml.js</Item>
					<Item>ui/component-support.js</Item>
					<Item>ui/accessibility/cohtml-speech-api.js</Item>
					<Item>ui/utilities/utilities-network.js</Item>
					<Item>ui/utilities/utilities-online.js</Item>
				</ImportFiles>

				<UIAudioRules>
					<Item>ui-next/audio-rules.json</Item>
				</UIAudioRules>

				<UIScripts>
					<Item>ui/module.js</Item>
				</UIScripts>
			</Actions>
		</ActionGroup>
	</ActionGroups>
	<LocalizedText></LocalizedText>
</Mod>