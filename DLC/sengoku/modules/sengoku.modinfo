					<Item>l10n/fr_FR/wilco_civ_exploration_sengoku_economic.vtt</Item>
					<Item>l10n/fr_FR/wilco_civ_exploration_sengoku_military.vtt</Item>
					<Item>l10n/fr_FR/wilco_civ_exploration_sengoku_science.vtt</Item>
