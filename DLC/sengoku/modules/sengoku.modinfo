					<Item>l10n/zh_Hans_CN/wilco_civ_exploration_sengoku_culture.vtt</Item>
					<Item>l10n/zh_Hans_CN/wilco_civ_exploration_sengoku_economic.vtt</Item>
					<Item>l10n/zh_Hans_CN/wilco_civ_exploration_sengoku_military.vtt</Item>
					<Item>l10n/zh_Hans_CN/wilco_civ_exploration_sengoku_science.vtt</Item>
