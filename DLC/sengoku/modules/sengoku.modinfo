		<ActionGroup id="age-antiquity-sengoku-heian" scope="game" criteria="antiquity-age-heian">
			<Actions>
				<UpdateDatabase>
					<Item>data/unlocks-antiquity-heian.xml</Item>
				</UpdateDatabase>
			</Actions>
		</ActionGroup>
		<ActionGroup id="base-game-main-sengoku-ashoka-himiko-alt" scope="game" criteria="ashoka-himiko-alt-current">
			<Actions>
