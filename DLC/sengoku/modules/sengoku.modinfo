				</ImportFiles>

				<ImportFiles locale="ru_RU">
					<Item>l10n/ru_RU/wilco_civ_exploration_sengoku_defeat.vtt</Item>
					<Item>l10n/ru_RU/wilco_civ_exploration_sengoku_culture.vtt</Item>
					<Item>l10n/ru_RU/wilco_civ_exploration_sengoku_economic.vtt</Item>
