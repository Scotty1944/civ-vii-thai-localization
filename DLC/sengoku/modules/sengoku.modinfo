					<Item>data/civilizations-antiquity.xml</Item>
					<Item>data/progression-trees-culture-unique-aq.xml</Item>
					<Item>data/narrative-stories-gameeffects-antiquity.xml</Item>
					<Item>data/narrative-stories-antiquity.xml</Item>
					<Item>data/tot-narrative-stories-gameeffects.xml</Item>
					<Item>data/tot-narrative-stories.xml</Item>
				</UpdateDatabase>
			</Actions>
		</ActionGroup>
		<ActionGroup id="age-exploration-persist-sengoku" scope="game" criteria="exploration-age-persist">
			<Actions>
				<UpdateDatabase>
					<Item>data/constructibles.xml</Item>
					<Item>data/constructibles-gameeffects.xml</Item>
				</UpdateDatabase>
			</Actions>
		</ActionGroup>
		<ActionGroup id="age-exploration-main-sengoku" scope="game" criteria="exploration-age-current">
			<Actions>
				<UpdateDatabase>
					<Item>data/citizen-names.xml</Item>
					<Item>data/civilizations-exploration.xml</Item>
					<Item>data/civilizations-gameeffects.xml</Item>
