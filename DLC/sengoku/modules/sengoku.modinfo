<?xml version="1.0" encoding="utf-8"?>
<Mod id="sengoku" version="1"
	xmlns="ModInfo">
	<Properties>
		<Name>LOC_MODULE_SENGOKU_NAME</Name>
		<Description>LOC_MODULE_SENGOKU_DESCRIPTION</Description>
		<Authors>LOC_AUTHORS_FIRAXIS</Authors>
		<EnabledByDefault>1</EnabledByDefault>
		<Package>Platypus</Package>
	</Properties>
	<Dependencies>
		<Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME" />
	</Dependencies>
	<References>
		<Mod id="age-exploration" title="LOC_MODULE_AGE_EXPLORATION_NAME" />
	</References>
	<ActionCriteria>
		<Criteria id="antiquity-age-current">
			<AgeInUse>AGE_ANTIQUITY</AgeInUse>
		</Criteria>
		<Criteria id="exploration-age-current">
			<AgeInUse>AGE_EXPLORATION</AgeInUse>
		</Criteria>
		<Criteria id="exploration-age-persist" any="true">
			<AgeInUse>AGE_EXPLORATION</AgeInUse>
			<AgeInUse>AGE_MODERN</AgeInUse>
		</Criteria>
		<Criteria id="modern-age-current">
			<AgeInUse>AGE_MODERN</AgeInUse>
		</Criteria>
		<Criteria id="heian-current-shell">
			<ModIsEnabled>heian</ModIsEnabled>
		</Criteria>
		<Criteria id="antiquity-age-heian">
			<ModInUse>heian</ModInUse>
		</Criteria>
		<Criteria id="ashoka-himiko-alt-current">
			<ModInUse>ashoka-himiko-alt</ModInUse>
		</Criteria>
		<Criteria id="ashoka-himiko-alt-current-shell">
			<ModIsEnabled>ashoka-himiko-alt</ModIsEnabled>
		</Criteria>
		<Criteria id="toyotomi-hideyoshi-current">
			<ModInUse>toyotomi-hideyoshi</ModInUse>
		</Criteria>
		<Criteria id="toyotomi-hideyoshi-current-shell">
			<ModIsEnabled>toyotomi-hideyoshi</ModIsEnabled>
		</Criteria>
		<Criteria id="always">
			<AlwaysMet></AlwaysMet>
		</Criteria>
	</ActionCriteria>
	<ActionGroups>
		<ActionGroup id="sengoku-art" scope="game" criteria="always">
			<Actions>
				<UpdateArt>
					<Item>sengoku-shell</Item>
					<Item>sengoku</Item>
				</UpdateArt>
				<UpdateIcons>
					<Item>data/icons/icons.xml</Item>
				</UpdateIcons>
			</Actions>
		</ActionGroup>
		<ActionGroup id="sengoku-movies" scope="game" criteria="always">
			<Actions>
				<UpdateDatabase>
					<Item>data/movies.xml</Item>
				</UpdateDatabase>

				<ImportFiles locale="de_DE">
					<Item>l10n/de_DE/wilco_civ_exploration_sengoku_defeat.vtt</Item>
					<Item>l10n/de_DE/wilco_civ_exploration_sengoku_culture.vtt</Item>
					<Item>l10n/de_DE/wilco_civ_exploration_sengoku_economic.vtt</Item>
					<Item>l10n/de_DE/wilco_civ_exploration_sengoku_military.vtt</Item>
					<Item>l10n/de_DE/wilco_civ_exploration_sengoku_science.vtt</Item>
				</ImportFiles>

				<ImportFiles locale="es_ES">
					<Item>l10n/es_ES/wilco_civ_exploration_sengoku_defeat.vtt</Item>
					<Item>l10n/es_ES/wilco_civ_exploration_sengoku_culture.vtt</Item>
					<Item>l10n/es_ES/wilco_civ_exploration_sengoku_economic.vtt</Item>
					<Item>l10n/es_ES/wilco_civ_exploration_sengoku_military.vtt</Item>
					<Item>l10n/es_ES/wilco_civ_exploration_sengoku_science.vtt</Item>
				</ImportFiles>

				<ImportFiles locale="fr_FR">
					<Item>l10n/fr_FR/wilco_civ_exploration_sengoku_defeat.vtt</Item>
