					<Item>data/unlocks-ashoka-himiko-alt.xml</Item>
				</UpdateDatabase>
			</Actions>
		</ActionGroup>
		<ActionGroup id="base-game-main-sengoku-toyotomi-hideyoshi" scope="game" criteria="toyotomi-hideyoshi-current">
