					<Item>l10n/ko_KR/wilco_civ_exploration_sengoku_economic.vtt</Item>
					<Item>l10n/ko_KR/wilco_civ_exploration_sengoku_military.vtt</Item>
					<Item>l10n/ko_KR/wilco_civ_exploration_sengoku_science.vtt</Item>
				</ImportFiles>

				<ImportFiles locale="pl_PL">
					<Item>l10n/pl_PL/wilco_civ_exploration_sengoku_defeat.vtt</Item>
					<Item>l10n/pl_PL/wilco_civ_exploration_sengoku_culture.vtt</Item>
					<Item>l10n/pl_PL/wilco_civ_exploration_sengoku_economic.vtt</Item>
					<Item>l10n/pl_PL/wilco_civ_exploration_sengoku_military.vtt</Item>
					<Item>l10n/pl_PL/wilco_civ_exploration_sengoku_science.vtt</Item>
				</ImportFiles>

				<ImportFiles locale="pt_BR">
					<Item>l10n/pt_BR/wilco_civ_exploration_sengoku_defeat.vtt</Item>
					<Item>l10n/pt_BR/wilco_civ_exploration_sengoku_culture.vtt</Item>
					<Item>l10n/pt_BR/wilco_civ_exploration_sengoku_economic.vtt</Item>
